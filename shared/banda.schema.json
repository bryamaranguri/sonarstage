{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bryamaranguri/sonarstage/shared/banda.schema.json",
  "title": "Banda de SonarStage",
  "description": "Músicos de una banda y qué stems cubre cada uno por defecto. Vive en Biblioteca/_bandas/<id>.json.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "musicians"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "musicians": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "default"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "description": "Nombre visible; también nombra su pista EN VIVO." },
          "role": {
            "enum": ["drums", "perc", "bass", "eg", "ag", "keys", "piano", "organ", "synth", "pad",
                     "strings", "leadVocal", "choir", "fx", "extra"]
          },
          "default": {
            "type": "array",
            "minItems": 1,
            "description": "Stems (por nombre, sin distinguir mayúsculas) que cubre en toda la canción cuando no hay matriz.",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
